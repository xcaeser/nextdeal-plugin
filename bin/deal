#!/bin/sh
# The plugin's one program, holding no code of ours. The first run fetches the
# compiled CLI for this machine and every later run goes straight to it. What it
# fetches must match a hash pinned here at release, so a compromised download
# host cannot run anything on this machine. Stdout belongs to the CLI alone,
# because agents parse it.

# Stamped by scripts/release.ts. Blank in this repo, which runs from source.
release=0.0.1-194acf49
cloud=https://nextdeal-cloud.elbantli.com
sha_darwin_arm64=d0bc25d8b1cb78e5c34893f9bd52f45ade5f7089b04d04c122b1e33e7bcdac80
sha_darwin_x64=223b1b9d4742f8f59424658e8d1ce8dda5800d6679a3057aac5da264adbfe81c
sha_linux_arm64=b9d5e3a85fc8dc4bc52ea07e459c327e57400b80f9cbcfe439b007231a90e10f
sha_linux_x64=01d247b5534317fe4f4d6a884c27ee4f8b074cac3837f33f0e1cb75354b9c637
sha_windows_x64=36c3e098bbb30814e55ab76bbd1e74d83a192044be3e0a2b7e98f3b97512e871

if [ -z "$release" ]; then
  # A deal folder holds a seller's files: nothing in it may configure bun.
  root="$(dirname "$0")/.."
  DEAL_PACK="${DEAL_PACK-$root/dist/pack}" exec bun --no-env-file --config=/dev/null "$root/src/cli/main.ts" "$@"
fi

refuse() {
  printf '{"ok":false,"error":"%s","hint":"%s"}\n' "$1" "$2" >&2
  exit 1
}

sha_for_this_machine() {
  case $(uname -s) in
    Darwin) os=darwin ;;
    Linux) os=linux ;;
    MINGW* | MSYS* | CYGWIN*) os=windows ;;
    *) os=$(uname -s) ;;
  esac
  case $(uname -m) in
    arm64 | aarch64) arch=arm64 ;;
    x86_64 | amd64) arch=x64 ;;
    *) arch=$(uname -m) ;;
  esac
  # Under Rosetta an Apple silicon Mac reports Intel; the native build is quicker.
  if [ "$os-$arch" = darwin-x64 ] && [ "$(sysctl -n sysctl.proc_translated 2>/dev/null)" = 1 ]; then
    arch=arm64
  fi
  case $os-$arch in
    darwin-arm64) sha=$sha_darwin_arm64 ;;
    darwin-x64) sha=$sha_darwin_x64 ;;
    linux-arm64) sha=$sha_linux_arm64 ;;
    linux-x64) sha=$sha_linux_x64 ;;
    # Windows on Arm runs the Intel build under emulation.
    windows-*) sha=$sha_windows_x64 ;;
    *) refuse "No deal CLI for $os on $arch" "Use macOS, Windows, or glibc Linux on x64 or arm64" ;;
  esac
}

install() {
  if [ -n "${CODEX_SANDBOX_NETWORK_DISABLED:-}" ]; then
    refuse "The deal CLI is not installed yet" "Run this same command again outside the sandbox, with the user's approval: the first run needs the network and writes to ~/.deal"
  fi
  sha_for_this_machine
  if command -v sha256sum >/dev/null 2>&1; then
    hasher='sha256sum'
  elif command -v shasum >/dev/null 2>&1; then
    hasher='shasum -a 256'
  elif command -v openssl >/dev/null 2>&1; then
    hasher='openssl dgst -sha256 -r'
  else
    refuse "Nothing here can check the download, so it was not fetched" "Install sha256sum, shasum or openssl, then run the command again"
  fi
  if command -v curl >/dev/null 2>&1; then
    fetch='curl -fsSL --connect-timeout 15 --max-time 600 --retry 2 -o'
  elif command -v wget >/dev/null 2>&1; then
    fetch='wget -q -T 30 -O'
  else
    refuse "Neither curl nor wget is here to fetch the deal CLI" "Install curl, then run the command again"
  fi

  dir=$(dirname "$bin")
  mkdir -p "$dir" || refuse "Cannot write the deal CLI's folder" "Make ~/.deal writable, then run the command again"
  # A run killed part way leaves its folder behind; a live one is under an hour.
  find "$dir" -name '.part-*' -mmin +60 -exec rm -rf {} + 2>/dev/null
  # Each run works alone and arrives by one rename, so parallel first runs
  # cannot see a partial file, and a crash in one cannot block the rest.
  part=$dir/.part-$$
  trap 'rm -rf "$part"' EXIT
  trap 'exit 1' HUP INT TERM
  mkdir -p "$part" || refuse "Cannot write the deal CLI's folder" "Make ~/.deal writable, then run the command again"

  # shellcheck disable=SC2086 # Each holds a command and its flags.
  $fetch "$part/deal.tar.gz" "$cloud/v1/cli/$sha.tar.gz" >/dev/null 2>&1 ||
    refuse "Could not fetch the deal CLI from $cloud" "Check the connection, or ask IT to allow that address, then run the command again"
  # shellcheck disable=SC2086
  got=$($hasher "$part/deal.tar.gz" | cut -d' ' -f1)
  [ "$got" = "$sha" ] ||
    refuse "The download does not match this release, so it was not run" "Run the command again. If this repeats, tell the publisher: something changed the file on its way here"
  tar -xzf "$part/deal.tar.gz" -C "$part" >/dev/null 2>&1 ||
    refuse "The download could not be unpacked" "Run the command again"
  chmod +x "$part/$program" && mv -f "$part/$program" "$bin" ||
    refuse "Cannot write the deal CLI's folder" "Make ~/.deal writable, then run the command again"
  rm -rf "$part"
  trap - EXIT

  # Three stay: a login item can name an older one until its deal next runs.
  ls -1t "$home/cli" | tail -n +4 | while IFS= read -r old; do
    rm -rf "${home:?}/cli/$old"
  done
}

# Codex plugins cannot ship agents, so they go where Codex reads them, and it
# picks them up in the next session. Best effort: the CLI works without them.
install_codex_agents() {
  from=$(dirname "$0")/../codex-agents
  mkdir -p "$agents" 2>/dev/null &&
    rm -f "$agents"/deal-*.toml "$agents"/.deal-* 2>/dev/null &&
    cp "$from"/*.toml "$agents/" 2>/dev/null &&
    : >"$agents/.deal-$release"
}

# Git Bash runs this file on Windows, where the archive holds deal.exe.
case ${OS:-} in
  Windows_NT) program=deal.exe ;;
  *) program=deal ;;
esac
home=${DEAL_HOME:-${HOME:-}/.deal}
bin=$home/cli/$release/$program
agents=${CODEX_HOME:-${HOME:-}/.codex}/agents

# No program runs on this path once installed: the app answers within a blink
# of a command, and starting the shell is already most of the cost.
[ -x "$bin" ] || install
[ -z "${CODEX_THREAD_ID:-}" ] || [ -e "$agents/.deal-$release" ] || install_codex_agents
exec "$bin" "$@"
